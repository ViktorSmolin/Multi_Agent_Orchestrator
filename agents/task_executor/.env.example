MAO_WS_URL=ws://127.0.0.1:8090/ws
MAO_AGENT_ID=task-executor-agent
TASK_EXECUTION_DELAY_SECONDS=2
ACK_TIMEOUT_SECONDS=10
HANDSHAKE_TIMEOUT_SECONDS=10
RECONNECT_BASE_SECONDS=1
RECONNECT_MAX_SECONDS=30
AGENT_HEALTH_PORT=8091
HEALTH_PING_INTERVAL_SECONDS=10
HEALTH_MAX_ACTIVITY_AGE_SECONDS=30
AGENT_STATE_DIR=/app/state
OUTBOX_RETRY_INTERVAL_SECONDS=2
OUTBOX_MAX_BACKOFF_SECONDS=30
TRIGGER_TIMEOUT_SECONDS=30
